# Copy to .env. Never commit it. All passwords/keys are intentionally empty.
R8D_ADMIN_USERNAME=admin
R8D_ADMIN_PASSWORD=
R8D_API_KEY=
R8D_API_BASE=
R8D_API_MODEL=
# Name the actual AI service provider shown on the consent screen.
R8D_AI_SERVICE_NAME=尚未配置
R8D_AI_DAILY_USER=20
R8D_AI_DAILY_TOTAL=100
R8D_AI_MONTHLY_TOTAL=1000
R8D_STORAGE_MB=100
# Local Docker preview only. Public use requires HTTPS and true.
R8D_COOKIE_SECURE=false
R8D_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional HTTPS profile: set a real DNS name pointing to the server before starting.
R8D_DOMAIN=
